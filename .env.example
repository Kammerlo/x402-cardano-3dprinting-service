# Vercel web (build time)
VITE_API_URL=https://api.example.workers.dev
VITE_BLOCKFROST_MAINNET_PROJECT_ID=YOUR_MAINNET_BLOCKFROST_PROJECT_ID
VITE_BLOCKFROST_PREPROD_PROJECT_ID=YOUR_PREPROD_BLOCKFROST_PROJECT_ID

# Cloudflare Worker secrets (set via wrangler secret put, not here)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
FACILITATOR_URL=https://YOUR_HOSTED_FACILITATOR
CARDANO_NETWORK=cardano:mainnet
SELLER_ADDRESS=addr1YOUR_CARDANO_MAINNET_ADDRESS
ADMIN_TOKEN=GENERATE_A_LONG_RANDOM_SECRET
GATEWAY_TOKEN=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
GATEWAY_URL=https://gateway.example.com
ACCESS_CLIENT_ID=CLOUDFLARE_ACCESS_SERVICE_TOKEN_ID
ACCESS_CLIENT_SECRET=CLOUDFLARE_ACCESS_SERVICE_TOKEN_SECRET
FRONTEND_ORIGIN=https://YOUR-VERCEL-DOMAIN.vercel.app

# Home gateway (never commit actual values)
API_URL=https://api.example.workers.dev
GATEWAY_TOKEN=SAME_GATEWAY_TOKEN_AS_WORKER
MOONRAKER_URL=http://snapmaker-u1-or-moonraker-ip:7125
MOONRAKER_API_KEY=IF_CONFIGURED
PRINTS_DIR=/prints
STATE_DIR=/data
ARM_ONCE=true
