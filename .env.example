# Hosted deployment: examples only. Do not paste this file into a public build or commit filled values.
# Cloudflare Worker Variables (Settings -> Variables and Secrets; non-secret).
CARDANO_NETWORK=cardano:preprod
PRICE_LOVELACE=5000000
FRONTEND_ORIGIN=https://YOUR-WORKER.YOUR-SUBDOMAIN.workers.dev
# Demo limits and privacy. MAX_ORDERS: total paid orders before checkout closes (empty/0 = unlimited).
MAX_ORDERS=
PII_RETENTION_DAYS=90
# Shown on /privacy and /imprint. Use \n for line breaks in the address.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
OPERATOR_VAT_ID=
OPERATOR_REPRESENTATIVE=
OPERATOR_REGISTER=
PRIVACY_SUPERVISORY_AUTHORITY=

# Cloudflare Worker Secrets. Set in the dashboard as Secret or with:
# npx wrangler secret put NAME --config apps/api/wrangler.jsonc
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
FACILITATOR_URL=https://YOUR_HOSTED_FACILITATOR
SELLER_ADDRESS=addr_test1YOUR_PREPROD_RECEIVING_ADDRESS
ADMIN_TOKEN=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
GATEWAY_TOKEN=REPLACE_WITH_A_DIFFERENT_64_RANDOM_HEX_CHARACTERS
BLOCKFROST_PREPROD_PROJECT_ID=YOUR_PREPROD_PROJECT_ID
BLOCKFROST_MAINNET_PROJECT_ID=YOUR_MAINNET_PROJECT_ID

# Web build-time values: VITE_* are embedded in public browser JavaScript.
# Set only the IDs for the networks you offer. Use a dedicated, quota-limited project.
VITE_BLOCKFROST_PREPROD_PROJECT_ID=YOUR_PREPROD_PROJECT_ID
VITE_BLOCKFROST_MAINNET_PROJECT_ID=YOUR_MAINNET_PROJECT_ID

# Keep ADMIN_ALLOW_BEARER unset. ADMIN_ALLOW_INSECURE_LOCALHOST is local HTTP only.
# Gateway settings belong in .env.gateway; see .env.gateway.example.
