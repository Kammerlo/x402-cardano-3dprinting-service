# Copy to .env.gateway. Never commit the filled file.
# The storefront/Worker origin, WITHOUT /api or a trailing slash.
API_URL=https://x402-cardano-3dprinting-service.th-kammerlocher.workers.dev

# Copy the EXISTING 64-character hexadecimal GATEWAY_TOKEN from your Worker.
# This must be different from ADMIN_TOKEN. No admin token is needed here.
GATEWAY_TOKEN=REPLACE_WITH_THE_SAME_GATEWAY_TOKEN_AS_CLOUDFLARE

# Private printer IP reachable FROM the Docker container; not localhost.
MOONRAKER_URL=http://192.168.1.100:7125
# Leave empty only if Moonraker already allows this host without an API key.
MOONRAKER_API_KEY=

# PRINTS_DIR=/prints and STATE_DIR=/data are set by Compose to match its mounts.
# No DATABASE_URL, wallet keys, Blockfrost keys or facilitator settings needed.
