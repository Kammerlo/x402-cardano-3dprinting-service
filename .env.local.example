# Copy to .env, fill with real values. Never commit .env.
POSTGRES_PASSWORD=CHANGE_TO_RANDOM_LOCAL_PASSWORD
CARDANO_NETWORK=cardano:preprod
FACILITATOR_URL=https://YOUR_HOSTED_FACILITATOR
SELLER_ADDRESS=addr_test1YOUR_REAL_PREPROD_ADDRESS
PRICE_LOVELACE=5000000
ADMIN_TOKEN=CHANGE_TO_64_RANDOM_HEX_CHARACTERS
GATEWAY_TOKEN=CHANGE_TO_A_DIFFERENT_64_RANDOM_HEX_CHARACTERS
BLOCKFROST_PREPROD_PROJECT_ID=YOUR_REAL_PREPROD_PROJECT_ID
BLOCKFROST_MAINNET_PROJECT_ID=
# Demo limits and privacy. MAX_ORDERS: total paid orders before checkout closes (empty/0 = unlimited).
MAX_ORDERS=
PII_RETENTION_DAYS=90
# Shown on /privacy and /imprint. Use \n for line breaks in the address.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
OPERATOR_PHONE=
OPERATOR_VAT_ID=
OPERATOR_REPRESENTATIVE=
OPERATOR_REGISTER=
PRIVACY_SUPERVISORY_AUTHORITY=
MOONRAKER_URL=http://YOUR_U1_MOONRAKER_LAN_HOST:7125
MOONRAKER_API_KEY=
VITE_BLOCKFROST_PREPROD_PROJECT_ID=YOUR_REAL_PREPROD_PROJECT_ID
VITE_BLOCKFROST_MAINNET_PROJECT_ID=
